# PostgreSQL real. El servidor no inicia sin esta variable.
DATABASE_URL="postgresql://postgres:TU_PASSWORD_DE_POSTGRES@db.tu-proyecto.supabase.co:5432/postgres"

# Secreto aleatorio de al menos 32 caracteres para firmar sesiones.
JWT_SECRET="REEMPLAZAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO"

# Google Gemini para analizar texto, audio y consultar cotizaciones.
GEMINI_API_KEY="REEMPLAZAR_POR_LA_CLAVE_REAL"

# URL pública del sistema desplegado.
APP_URL="https://agrosys.ejemplo.com"

# Token privado elegido al configurar el webhook de WhatsApp.
WHATSAPP_VERIFY_TOKEN="REEMPLAZAR_POR_UN_TOKEN_PRIVADO"


# Puerto local y entorno.
PORT="3000"
NODE_ENV="development"
